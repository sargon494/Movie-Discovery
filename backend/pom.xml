<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tastedivekafka</groupId>
    <artifactId>backend</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!-- ═══════════════════════════════════════════
             KAFKA — Kafka Clients para consumir mensajes de Kafka
             Usado por el package kafka/ 
             para consumir peticiones y enviar respuestas
        ════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>3.7.0</version>
        </dependency>

        <!-- ═══════════════════════════════════════════
             DATABASE — PostgreSQL JDBC Driver para conexión 
             a la base de datos PostgreSQL
             Usado por el package database/ para consultas SQL
        ════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>

        <!-- ═══════════════════════════════════════════
             JSON — Jackson Databind para parsing de JSON
             Usado por casi todo el backend para manejar JSON
        ════════════════════════════════════════════════ -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.16.0</version>
        </dependency>

        <!-- ═══════════════════════════════════════════
             CACHE — Caffeine para caching de resultados de búsqueda
             Usado por el package cache/ para mejorar rendimiento
        ════════════════════════════════════════════════ -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.1.8</version>
        </dependency>

        <!-- ═══════════════════════════════════════════
             REST API — Jetty Server para exponer endpoints REST
             Usado por el package rest/ para servir peticiones
        ════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <version>11.0.20</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-servlet</artifactId>
            <version>11.0.20</version>
        </dependency>

                <!-- ═══════════════════════════════════════════
             BCRYPT — jBCrypt para hashing de contraseñas
             Usado por el package auth/ para seguridad de usuarios
             Las contraseñas viajan en texto plano sobre la red interna de Docker
             y son hasheadas/verificadas en el backend para evitar almacenar o transmitir contraseñas sin protección
        ════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- ═══════════════════════════════════════════
                LOGGING — Implementación de Logback para 
                logging interno del backend          
        ════════════════════════════════════════════════ -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.4.14</version>
        </dependency>

    </dependencies>

    <build>
        <!--
            Punto a la nueva estructura de fuentes:
            backend/src/main/java/...
        -->
        <sourceDirectory>src/main/java</sourceDirectory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>

        <plugins>

            <!-- ─────────────────────────────────────────
                Maven Shade Plugin
                Crea un JAR ejecutable con todas las dependencias incluidas
            ──────────────────────────────────────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.tastedivekafka.BackendApp</mainClass>
                                </transformer>
                                <!-- Realiza merge de archivos META-INF/services (necesario por Jetty) -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <!-- Elimina archivos de firma que rompen los JARs fat -->
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

                <!-- ─────────────────────────────────────────
                    Maven Compiler Plugin
                    Compila el código fuente con Java 17
                ──────────────────────────────────────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>